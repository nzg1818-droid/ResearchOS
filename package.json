{
  "name": "researchos",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first literature research workstation",
  "author": "ResearchOS contributors",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader native",
    "desktop": "electron .",
    "build": "tsc --noEmit && vite build --configLoader native",
    "test": "vitest run --pool=threads --configLoader native",
    "package:win": "npm run build && electron-builder --win dir",
    "package:installer": "npm run build && electron-builder --win nsis",
    "package:portable": "powershell -File scripts/build-windows.ps1",
    "format": "prettier --write frontend electron vite.config.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.3.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "org.researchos.desktop",
    "productName": "ResearchOS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist/researchos-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "npmRebuild": false
  },
  "type": "module"
}
